#--- source.hlsl
// Copy an input array from a structured buffer and do a simple reduction
#define GROUP_SIZE 16

StructuredBuffer<uint4[GROUP_SIZE << 1]> In : register(t1);
RWStructuredBuffer<uint4> Out : register(u0);

groupshared uint4 SMem[GROUP_SIZE << 1];

[numthreads(GROUP_SIZE, 1, 1)]
void main(uint GroupIndex : SV_GroupIndex) {
  if (GroupIndex == 0)
    SMem = In[0];

  for (int I = GROUP_SIZE; I > 0; I >>= 1)
    if (GroupIndex < I) {
      SMem[GroupIndex] += SMem[GroupIndex + I];
      GroupMemoryBarrierWithGroupSync();
    }

  if (GroupIndex == 0)
    Out[0] = SMem[0];
}
//--- pipeline.yaml
---
Shaders:
  - Stage: Compute
    Entry: main
Buffers:
  - Name: In
    Format: UInt32
    Stride: 512
    Data: [
       1,  10,  100,  1000,
       2,  20,  200,  2000,
       3,  30,  300,  3000,
       4,  40,  400,  4000,
       5,  50,  500,  5000,
       6,  60,  600,  6000,
       7,  70,  700,  7000,
       8,  80,  800,  8000,
       9,  90,  900,  9000,
      10, 100, 1000, 10000,
      11, 110, 1100, 11000,
      12, 120, 1200, 12000,
      13, 130, 1300, 13000,
      14, 140, 1400, 14000,
      15, 150, 1500, 15000,
      16, 160, 1600, 16000,
      17, 170, 1700, 17000,
      18, 180, 1800, 18000,
      19, 190, 1900, 19000,
      20, 200, 2000, 20000,
      21, 210, 2100, 21000,
      22, 220, 2200, 22000,
      23, 230, 2300, 23000,
      24, 240, 2400, 24000,
      25, 250, 2500, 25000,
      26, 260, 2600, 26000,
      27, 270, 2700, 27000,
      28, 280, 2800, 28000,
      29, 290, 2900, 29000,
      30, 300, 3000, 30000,
      31, 310, 3100, 31000,
      32, 320, 3200, 32000,
    ]
  - Name: Out
    Format: UInt32
    Stride: 16
    FillSize: 16
  - Name: ExpectedOut
    Format: UInt32
    Stride: 16
    Data: [ 528, 5280, 52800, 528000 ]
Results:
  - Result: Test0
    Rule: BufferExact
    Actual: Out
    Expected: ExpectedOut
DescriptorSets:
  - Resources:
    - Name: In
      Kind: StructuredBuffer
      DirectXBinding:
        Register: 1
        Space: 0
      VulkanBinding:
        Binding: 1
    - Name: Out
      Kind: RWStructuredBuffer
      DirectXBinding:
        Register: 0
        Space: 0
      VulkanBinding:
        Binding: 0
...
#--- end

# TODO: Bug?
# XFAIL: Clang && Vulkan

# RUN: split-file %s %t
# RUN: %dxc_target -T cs_6_0 -Fo %t.o %t/source.hlsl
# RUN: %offloader %t/pipeline.yaml %t.o
